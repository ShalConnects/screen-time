<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Smart Notifications -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Notifications"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/notificationSettingsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Notification Settings"
                android:textSize="12sp"
                android:padding="8dp"
                android:layout_marginEnd="4dp"
                android:maxLines="2"
                android:ellipsize="none"/>

            <Button
                android:id="@+id/testNotificationButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Test Notifications"
                android:textSize="12sp"
                android:padding="8dp"
                android:layout_marginStart="4dp"
                android:maxLines="2"
                android:ellipsize="none"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/reminderSettingsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reminder Settings"
                android:textSize="12sp"
                android:padding="8dp"
                android:layout_marginEnd="4dp"
                android:maxLines="2"
                android:ellipsize="none"/>

            <Button
                android:id="@+id/breakSettingsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Break Settings"
                android:textSize="12sp"
                android:padding="8dp"
                android:layout_marginStart="4dp"
                android:maxLines="2"
                android:ellipsize="none"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
