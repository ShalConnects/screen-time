<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Screen Time Monitor"
        android:textSize="24sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Track usage, set goals, and stay focused"
        android:textSize="16sp"
        android:textColor="@color/text_tertiary"
        android:layout_marginBottom="48dp"/>

    <!-- Core Controls -->
    <Button
        android:id="@+id/startButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="START OVERLAY"
        android:textSize="16sp"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:textStyle="bold"/>

    <Button
        android:id="@+id/stopButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="STOP OVERLAY"
        android:textSize="16sp"
        android:padding="16dp"
        android:layout_marginBottom="32dp"
        android:textStyle="bold"/>

    <!-- Basic Settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@drawable/glass_background"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Touch Passthrough"
            android:textColor="@color/text_primary"
            android:textSize="16sp"/>

        <Switch
            android:id="@+id/touchPassthroughSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@drawable/glass_background"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Per-App Mode"
            android:textColor="@color/text_primary"
            android:textSize="16sp"/>

        <Switch
            android:id="@+id/perAppSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@drawable/glass_background"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Auto-Hide Mode"
            android:textColor="@color/text_primary"
            android:textSize="16sp"/>

        <Switch
            android:id="@+id/autoHideSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <!-- Daily Goal Setting -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/glass_background"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daily Goal"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/goalHoursEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Hours"
                android:inputType="number"
                android:text="8"
                android:textColor="@color/text_primary"
                android:textColorHint="#B0B0B0"
                android:background="@drawable/glass_background"
                android:padding="12dp"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/goalMinutesEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Minutes"
                android:inputType="number"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textColorHint="#B0B0B0"
                android:background="@drawable/glass_background"
                android:padding="12dp"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/setGoalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SET"
                android:textSize="14sp"
                android:padding="12dp"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Display Modes -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Display Modes"
        android:textSize="18sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/compactModeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Compact"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/button_glass"/>

        <Button
            android:id="@+id/progressModeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Progress"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/button_glass"/>

        <Button
            android:id="@+id/detailedModeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Detailed"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/button_glass"/>

    </LinearLayout>

    <!-- Position Settings -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Position Settings"
        android:textSize="18sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/autoPositionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Auto"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/button_glass"/>

        <Button
            android:id="@+id/topRightPositionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Top Right"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/button_glass"/>

        <Button
            android:id="@+id/bottomRightPositionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bottom Right"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/button_glass"/>

    </LinearLayout>

    <!-- Core Features -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Core Features"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/batteryOptimizationButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Battery Settings"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginEnd="4dp"
            android:maxLines="2"
            android:ellipsize="none"/>

        <Button
            android:id="@+id/accessibilityButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Accessibility"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:maxLines="2"
            android:ellipsize="none"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/appFilterButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="App Filters"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginEnd="4dp"
            android:maxLines="2"
            android:ellipsize="none"/>

        <Button
            android:id="@+id/exportWeeklyButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Export Week"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:maxLines="2"
            android:ellipsize="none"/>

    </LinearLayout>

    <Button
        android:id="@+id/exportDailyButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Export Today"
        android:textSize="14sp"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:maxLines="2"
        android:ellipsize="none"/>

    <!-- Analytics Features -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Analytics and Insights"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/sessionStatsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Session Stats"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginEnd="4dp"
            android:maxLines="2"
            android:ellipsize="none"/>

        <Button
            android:id="@+id/productivityButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Productivity"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:maxLines="2"
            android:ellipsize="none"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/patternAnalysisButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pattern Analysis"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginEnd="4dp"
            android:maxLines="2"
            android:ellipsize="none"/>

        <Button
            android:id="@+id/breakTimeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Break Times"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:maxLines="2"
            android:ellipsize="none"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/weeklyViewButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Weekly View"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginEnd="4dp"
            android:maxLines="2"
            android:ellipsize="none"/>

        <Button
            android:id="@+id/monthlyViewButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Monthly View"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:maxLines="2"
            android:ellipsize="none"/>

    </LinearLayout>

    <!-- Smart Notifications -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Smart Notifications"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/notificationSettingsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notification Settings"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginEnd="4dp"
            android:maxLines="2"
            android:ellipsize="none"/>

        <Button
            android:id="@+id/testNotificationButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Test Notifications"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:maxLines="2"
            android:ellipsize="none"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/reminderSettingsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reminder Settings"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginEnd="4dp"
            android:maxLines="2"
            android:ellipsize="none"/>

        <Button
            android:id="@+id/breakSettingsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Break Settings"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:maxLines="2"
            android:ellipsize="none"/>

    </LinearLayout>

    <!-- Performance Monitoring -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Performance"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/performanceButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Performance Metrics"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginEnd="4dp"
            android:maxLines="2"
            android:ellipsize="none"/>

        <Button
            android:id="@+id/optimizationButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Optimization Tips"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:maxLines="2"
            android:ellipsize="none"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/memoryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Memory Stats"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginEnd="4dp"
            android:maxLines="2"
            android:ellipsize="none"/>

        <Button
            android:id="@+id/batteryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Battery Usage"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:maxLines="2"
            android:ellipsize="none"/>

    </LinearLayout>

    <!-- Basic Personalization -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Personalization"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/customGoalsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Custom Goals"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginEnd="4dp"
            android:maxLines="2"
            android:ellipsize="none"/>

        <Button
            android:id="@+id/appCategoriesButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="App Categories"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:maxLines="2"
            android:ellipsize="none"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/timezoneButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Timezone"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginEnd="4dp"
            android:maxLines="2"
            android:ellipsize="none"/>

        <Button
            android:id="@+id/profilesButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Profiles"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:maxLines="2"
            android:ellipsize="none"/>

    </LinearLayout>

    <Button
        android:id="@+id/personalizationButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Personalization Summary"
        android:textSize="14sp"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:maxLines="2"
        android:ellipsize="none"/>

    <!-- Feature Summary -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💡 Tap overlay to pause for 5 minutes\n💡 Drag to move, auto-snaps to edges\n📱 Per-app mode shows current app time\n🎯 Set daily goals for gentle nudges\n🔋 Battery optimization for reliability\n📊 Export weekly summaries\n📈 Session tracking and productivity scoring\n🧠 Usage pattern analysis and break recommendations\n📅 Weekly/monthly historical views\n🔔 Smart contextual reminders and break suggestions\n🎉 Goal celebrations and customizable alerts\n⚡ Performance monitoring and optimization\n🎯 Custom goals for weekdays/weekends\n📱 App categories and custom grouping\n🌍 Timezone support and auto-detection\n👤 Multiple profiles for work/personal use"
        android:textSize="14sp"
        android:textColor="@color/text_tertiary"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="4dp"/>

</LinearLayout>

</ScrollView>