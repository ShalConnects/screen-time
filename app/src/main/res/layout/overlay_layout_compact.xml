<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <!-- Compact Content -->
        <LinearLayout
            android:id="@+id/compactContainer"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/glass_background"
            android:gravity="center"
            android:minWidth="120dp">

            <!-- Title -->
            <TextView
                android:id="@+id/titleTextCompact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Screen Time"
                android:textSize="11sp"
                android:textColor="#E0E0E0"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:layout_marginBottom="4dp"/>

            <!-- Time Display -->
            <TextView
                android:id="@+id/timeTextCompact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"/>

            <!-- Reminder Message Display -->
            <TextView
                android:id="@+id/reminderTextCompact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="8sp"
                android:textColor="#FFFFFF"
                android:textAlignment="center"
                android:visibility="gone"
                android:layout_marginTop="2dp"/>

            <!-- Seconds Display -->
            <TextView
                android:id="@+id/timeSecondsCompact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#B0B0B0"
                android:layout_marginTop="2dp"/>

        </LinearLayout>


    </FrameLayout>

</FrameLayout>
