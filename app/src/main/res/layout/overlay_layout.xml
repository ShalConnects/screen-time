<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="14dp"
    app:cardCornerRadius="8dp"
    app:cardBackgroundColor="#00000000">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <!-- Main Container -->
        <LinearLayout
            android:id="@+id/mainContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/glass_background"
            android:gravity="center"
            android:minWidth="160dp">

            <!-- Title -->
            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Screen Time"
                android:textSize="12sp"
                android:textColor="#E0E0E0"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:layout_marginBottom="6dp"/>

            <!-- Time Display -->
            <TextView
                android:id="@+id/timeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:layout_marginBottom="2dp"/>

            <!-- Reminder Message Display -->
            <TextView
                android:id="@+id/reminderText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:textAlignment="center"
                android:visibility="gone"
                android:layout_marginBottom="4dp"
                android:background="@drawable/reminder_background"
                android:padding="8dp"
                android:shadowColor="#80000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:fontFamily="sans-serif-medium"/>

            <!-- Seconds Display -->
            <TextView
                android:id="@+id/timeSeconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#B0B0B0"
                android:layout_marginBottom="4dp"/>

            <!-- Date -->
            <TextView
                android:id="@+id/dateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#A0A0A0"
                android:layout_marginBottom="6dp"/>

            <!-- Goal Text -->
            <TextView
                android:id="@+id/goalText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textColor="@color/text_tertiary"
                android:layout_marginBottom="8dp"/>

            <!-- Progress Bar (hidden by default) -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="120dp"
                android:layout_height="6dp"
                android:progress="0"
                android:max="100"
                android:progressDrawable="@drawable/progress_bar_animated"
                android:background="@drawable/progress_bar_background"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- Expanded Container -->
        <LinearLayout
            android:id="@+id/expandedContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/glass_background"
            android:gravity="center"
            android:minWidth="200dp"
            android:visibility="gone">

            <!-- Title -->
            <TextView
                android:id="@+id/titleTextExpanded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Screen Time"
                android:textSize="12sp"
                android:textColor="#E0E0E0"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:layout_marginBottom="8dp"/>

            <!-- Time Display -->
            <TextView
                android:id="@+id/timeTextExpanded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:layout_marginBottom="4dp"/>

            <!-- Reminder Message Display -->
            <TextView
                android:id="@+id/reminderTextExpanded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:textAlignment="center"
                android:visibility="gone"
                android:layout_marginBottom="4dp"/>

            <!-- Seconds Display -->
            <TextView
                android:id="@+id/timeSecondsExpanded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#B0B0B0"
                android:layout_marginBottom="6dp"/>

            <!-- Date -->
            <TextView
                android:id="@+id/dateTextExpanded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#A0A0A0"
                android:layout_marginBottom="8dp"/>

            <!-- Goal Text -->
            <TextView
                android:id="@+id/goalTextExpanded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@color/text_tertiary"
                android:layout_marginBottom="12dp"/>

            <!-- Top Apps Container -->
            <LinearLayout
                android:id="@+id/topAppsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:minWidth="180dp"/>

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="top|end"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:gravity="center">

            <!-- Close Button -->
            <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/button_close"
                android:src="@drawable/ic_close"
                android:scaleType="centerInside"
                android:contentDescription="Close"/>

        </LinearLayout>

    </FrameLayout>

</androidx.cardview.widget.CardView>
