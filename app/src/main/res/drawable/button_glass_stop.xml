<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Glass morphism with red gradient overlay -->
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#50FF6B6B"
        android:centerColor="#30FF6B6B"
        android:endColor="#20FF6B6B" />
    
    <!-- Rounded corners -->
    <corners android:radius="8dp" />
    
    <!-- Glass border with red tint -->
    <stroke
        android:width="1dp"
        android:color="#60FF6B6B" />
        
</shape>
