<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Glass morphism with green gradient overlay -->
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#50A5D6A5"
        android:centerColor="#30A5D6A5"
        android:endColor="#20A5D6A5" />
    
    <!-- Rounded corners -->
    <corners android:radius="8dp" />
    
    <!-- Glass border with green tint -->
    <stroke
        android:width="1dp"
        android:color="#60A5D6A5" />
        
</shape>
