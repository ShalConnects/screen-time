<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Advanced glass morphism with multiple layers -->
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#30FFFFFF"
        android:centerColor="#20FFFFFF"
        android:endColor="#10FFFFFF" />
    
    <!-- Rounded corners for modern glass effect -->
    <corners android:radius="20dp" />
    
    <!-- Subtle border for glass definition -->
    <stroke
        android:width="1dp"
        android:color="#40FFFFFF" />
    
    <!-- Inner shadow effect -->
    <padding
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp" />
        
</shape>
