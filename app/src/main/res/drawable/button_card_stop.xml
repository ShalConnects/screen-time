<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Stop state - Red gradient with glass effect -->
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#40FF6B6B"
        android:centerColor="#20FF6B6B"
        android:endColor="#10FF6B6B" />
    
    <!-- Rounded corners -->
    <corners android:radius="16dp" />
    
    <!-- Red border for stop state -->
    <stroke
        android:width="1dp"
        android:color="#50FF6B6B" />
        
</shape>
