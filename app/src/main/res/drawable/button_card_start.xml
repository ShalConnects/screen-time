<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Start state - Green gradient with glass effect -->
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#40A5D6A5"
        android:centerColor="#20A5D6A5"
        android:endColor="#10A5D6A5" />
    
    <!-- Rounded corners -->
    <corners android:radius="16dp" />
    
    <!-- Green border for start state -->
    <stroke
        android:width="1dp"
        android:color="#50A5D6A5" />
        
</shape>
