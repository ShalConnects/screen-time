<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Pulsing green gradient with glass effect -->
    <gradient
        android:type="radial"
        android:centerX="0.5"
        android:centerY="0.5"
        android:startColor="#60A5D6A5"
        android:centerColor="#40A5D6A5"
        android:endColor="#20A5D6A5" />
    
    <!-- Rounded corners for modern look -->
    <corners android:radius="16dp" />
    
    <!-- Green border with glow effect -->
    <stroke
        android:width="2dp"
        android:color="#80A5D6A5" />
        
</shape>
