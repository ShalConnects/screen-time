<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#40FFFFFF"
                android:centerColor="#25FFFFFF"
                android:endColor="#15FFFFFF" />
            <corners android:radius="18dp"/>
            <stroke
                android:width="1.5dp"
                android:color="#50FFFFFF"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#25FFFFFF"
                android:centerColor="#15FFFFFF"
                android:endColor="#08FFFFFF" />
            <corners android:radius="16dp"/>
            <stroke
                android:width="1dp"
                android:color="#30FFFFFF"/>
        </shape>
    </item>
</selector>
